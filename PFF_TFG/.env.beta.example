APP_NAME=OrganizaT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Modo SIN SSL de dominio (temporal): usa IP/host publico con http.
APP_URL=http://127.0.0.1
#ASSET_URL=http://127.0.0.1
# Modo CON SSL de dominio (cuando vuelva el certificado):
#APP_URL=https://beta.tu-dominio.com
#ASSET_URL=https://beta.tu-dominio.com
APP_TIMEZONE=Europe/Madrid

# Versión de la API (visible en la documentación OpenAPI en /docs/api)
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=organizat_beta
DB_USERNAME=organizat_beta
DB_PASSWORD=change_this_db_password
DB_ROOT_PASSWORD=change_this_root_password

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sin SSL de dominio (HTTP temporal)
#SESSION_SECURE_COOKIE=false
# Con SSL de dominio (HTTPS)
#SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis
CACHE_PREFIX=organizat_beta

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=resend
RESEND_API_KEY=replace_with_real_resend_api_key
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# SMTP legado (desactivado por defecto):
#MAIL_MAILER=smtp
#MAIL_SCHEME=smtp
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=replace_with_real_account
#MAIL_PASSWORD=replace_with_real_password
#MAIL_EHLO_DOMAIN=mail.tu-hostname.local
#MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuracion minima: define solo una de estas dos.
MOODLE_URL=
MOODLE_BASE_URL=
# Si CAS esta en otro dominio (ej: https://.../cas)
MOODLE_CAS_BASE=
CAS_BASE=
# Opcionales: si no se definen, se usa <MOODLE_BASE_URL>/login/index.php?authCAS=CAS
MOODLE_CAS_LOGIN_URL=
MOODLE_CAS_SERVICE_URL=
MOODLE_VERIFY_SSL=false
MOODLE_TIMEOUT=20
MOODLE_RETRY_ATTEMPTS=4
MOODLE_RETRY_DELAY_MS=1000
MOODLE_CACHE_TTL_SECONDS=300
MOODLE_CACHE_TASK_COURSE_LIMIT=50
MOODLE_CACHE_TASK_BUDGET_SECONDS=22
MOODLE_ASYNC_SECTION_TTL_SECONDS=1800

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=45

INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

APP_HTTP_PORT=80
